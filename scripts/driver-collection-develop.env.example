# Non-secret baseline for the existing develop API. No keys or DB values.
# Preserve its existing NODE_ENV and Supabase client configuration.
# Mount the existing private provider file read-only at:
# /run/vaydu/flutterwave-test.env (never copy it into the image/repository).
VAYDU_DEPLOYMENT_ENV=develop
VAYDU_DRIVER_SUBACCOUNT_COHOST_DEVELOP=false
VAYDU_DRIVER_SUBACCOUNT_SANDBOX=false
VAYDU_DRIVER_SUBACCOUNT_MERCHANT_VERIFIED=false
VAYDU_DRIVER_SUBACCOUNT_DEFAULT_APPROVED=false
VAYDU_DRIVER_PAYOUT_SANDBOX=false
VAYDU_DRIVER_TOPUP_API=false
VAYDU_FLUTTERWAVE_BOOKING_SPLIT_SANDBOX=false
VAYDU_BOOKING_SPLIT_TIMING_APPROVED=false
# VAYDU_DRIVER_SUBACCOUNT_FILE_OWNER_UID is verified from file metadata at rollout.
# Merchant identity and default split remain unresolved. No default value is supplied.
# Flutterwave LIVE credentials must remain absent/empty; Stripe is unchanged.
