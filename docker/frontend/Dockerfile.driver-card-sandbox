FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY . .
RUN node_modules/.bin/ng build mobile --configuration develop
FROM nginx:stable-alpine
COPY --from=builder /app/dist/mobile/browser /usr/share/nginx/html
COPY docker/frontend/default.driver-card-sandbox.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
